# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Google Earth Engine ────────────────────────────────────────────────────────
GEE_PROJECT=your-google-cloud-project-id

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lanzarote_landcover
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/lanzarote_landcover

# ── Redis (Celery broker) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (MinIO local / S3 in prod) ─────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lanzarote-tiles

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=change-me-in-production
